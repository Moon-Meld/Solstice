# Model Router Settings
USE_FINETUNED_SLM=false
FRONTIER_API_BASE=https://api.openai.com/v1
FRONTIER_API_KEY=sk-placeholder
FRONTIER_MODEL=gpt-4o

# Local vLLM / Ollama Fine-tuned SLM Endpoints
LOCAL_VLLM_BASE=http://localhost:8000/v1
LOCAL_KG_MODEL=Solstice-KG-Extractor-7B
LOCAL_WRITER_MODEL=Solstice-Artisan-Writer-14B

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=solstice_secret
NEO4J_DATABASE=neo4j

# Guardrail Flywheel DPO Logging
LOG_DIR=logs
GUARDRAIL_FLYWHEEL_PATH=logs/guardrail_flywheel.jsonl
